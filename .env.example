# Used by optional stdio shell AND as the value for plugin variable / Authorization Bearer.
# 看看播放器 website → account page, after an admin enables Grok Bot. Prefix is kkp_.
# Never commit a real key. Plaintext is shown only once when the key is created.
KANKAN_PLAYER_MCP_API_KEY=kkp_xxxxxxxx
# Remote default URL (no env needed for HTTP install):
#   https://kankanplayer.com/api/bot-mcp/v1/mcp
# Optional stdio BASE_URL. Default is production. https only, host must be kankanplayer.com.
# KANKAN_PLAYER_MCP_BASE_URL=https://kankanplayer.com/api/bot-mcp/v1
# Optional host lock. Must be kankanplayer.com or a subdomain of it. Default kankanplayer.com.
# KANKAN_PLAYER_MCP_ALLOWED_HOST_SUFFIX=kankanplayer.com
# Local API only: set this to 1 and point BASE_URL at http://localhost or http://127.0.0.1.
# KANKAN_PLAYER_MCP_ALLOW_INSECURE_LOCAL=1
