{
  "name": "kankan-player-mcp",
  "version": "1.0.0",
  "description": "看看播放器 cloud MCP — remote HTTPS (default) + optional stdio shell to control logged-in desktop and phone players (Grok Bot / Claude Desktop / Cursor).",
  "type": "module",
  "bin": {
    "kankan-player-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "kankanplayer",
    "kankan-player",
    "player",
    "grok-bot"
  ],
  "author": "KankanPlayer <support@kankanplayer.com>",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "AUTH.md",
    "LICENSE",
    "PRODUCT.md",
    "USAGE.md",
    "REMOTE.md",
    "skills",
    "assets",
    ".cursor-plugin",
    "mcp.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sdrom2008/kankan-player-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
